#!/usr/bin/env bash
# ==============================================================================
# Lanzador Nativo de Kitsune Go Wayland (Modo Tabbed • Sin Sway • Sin Dock)
# Compatible con SDDM, GDM, LightDM, greetd, ly o ejecución directa desde TTY.
# ==============================================================================
set -euo pipefail

export KITSUNE_PORT="${KITSUNE_PORT:-18080}"
export KITSUNE_URL="http://127.0.0.1:${KITSUNE_PORT}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP="KitsuneGoWayland"
export XCURSOR_THEME="${XCURSOR_THEME:-Bibata-Modern-Ice}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export MOZ_ENABLE_WAYLAND=1

mkdir -p "${HOME}/.config/kitsune-de/wallpapers" "${HOME}/.config/kitsune-de/shell-profile"

if [[ -d /usr/share/kitsune-de/wallpapers ]]; then
  cp -n /usr/share/kitsune-de/wallpapers/*.jpg "${HOME}/.config/kitsune-de/wallpapers/" 2>/dev/null || true
fi

# Iniciar motor Go de Kitsune Go Wayland en modo Tabbed predeterminado
kitsune-de --addr "127.0.0.1:${KITSUNE_PORT}" --workdir "${HOME}" --layout tabbed &
DE_PID=$!
cleanup() {
  kill "${DE_PID}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Esperar a que el motor Go esté listo
for _ in {1..30}; do
  if command -v curl >/dev/null 2>&1; then
    curl -fsS "${KITSUNE_URL}/api/health" >/dev/null 2>&1 && break
  fi
  sleep 0.1
done

CHROME_FLAGS=(
  "--ozone-platform-hint=auto"
  "--enable-gpu-rasterization"
  "--enable-zero-copy"
  "--autoplay-policy=no-user-gesture-required"
  "--disable-infobars"
  "--no-first-run"
  "--no-default-browser-check"
  "--user-data-dir=${HOME}/.config/kitsune-de/shell-profile"
  "--kiosk"
  "--app=${KITSUNE_URL}"
)

# Arranque directo sobre Wayland puro (desde TTY o Display Manager)
if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
  if command -v cage >/dev/null 2>&1; then
    for browser in chromium brave google-chrome-stable; do
      if command -v "${browser}" >/dev/null 2>&1; then
        cage -s -- "${browser}" "${CHROME_FLAGS[@]}"
        exit 0
      fi
    done
    if command -v firefox >/dev/null 2>&1; then
      cage -s -- firefox --kiosk "${KITSUNE_URL}"
      exit 0
    fi
  fi
fi

# Arranque dentro de una sesión Wayland/X11 existente
for browser in chromium brave google-chrome-stable; do
  if command -v "${browser}" >/dev/null 2>&1; then
    "${browser}" "${CHROME_FLAGS[@]}"
    exit 0
  fi
done

if command -v firefox >/dev/null 2>&1; then
  firefox --kiosk "${KITSUNE_URL}"
  exit 0
fi

wait "${DE_PID}"
