/* KitsuneDE Rofi Wayland Anime Launcher - Cyberpunk Neon Tokyo */
* {
    bg:      #0b0916E6;
    surface: #131026;
    primary: #00f0ff;
    accent:  #ff2a85;
    fg:      #eef6ff;
    muted:   #8f9bb8;
    font:    "JetBrainsMono Nerd Font 12";
}

window {
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @primary;
    border-radius: 12px;
    padding: 18px;
}

inputbar {
    children: [prompt, entry];
    background-color: @surface;
    border-radius: 10px;
    padding: 10px 14px;
    text-color: @fg;
}

prompt {
    text-color: @primary;
    padding: 0 10px 0 0;
}

listview {
    lines: 7;
    spacing: 6px;
    margin: 12px 0 0 0;
}

element selected {
    background-color: @primary;
    text-color: #0b0916;
    border-radius: 8px;
}
