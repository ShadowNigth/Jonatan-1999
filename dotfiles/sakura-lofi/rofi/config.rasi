/* KitsuneDE Rofi Anime Launcher - Sakura Catppuccin */
* {
    bg:      #181825E6;
    surface: #1e1e2e;
    primary: #f5c2e7;
    accent:  #cba6f7;
    fg:      #cdd6f4;
    muted:   #9399b2;
    font:    "JetBrainsMono Nerd Font 12";
}

window {
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @primary;
    border-radius: 12px;
    padding: 18px;
}

inputbar {
    children: [prompt, entry];
    background-color: @surface;
    border-radius: 10px;
    padding: 10px 14px;
    text-color: @fg;
}

prompt {
    text-color: @primary;
    padding: 0 10px 0 0;
}

listview {
    lines: 7;
    spacing: 6px;
    margin: 12px 0 0 0;
}

element selected {
    background-color: @primary;
    text-color: #181825;
    border-radius: 8px;
}
