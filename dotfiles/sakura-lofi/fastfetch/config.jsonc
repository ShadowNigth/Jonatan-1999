{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/kitsune-de/wallpapers/kitsune-avatar.jpg",
    "width": 26,
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": " ❯ ",
    "color": { "keys": "#f5c2e7", "title": "#cba6f7" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "󰣇 Distro" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "wm", "key": "🦊 Wayland DE", "format": "Kitsune Go Wayland (Tabbed • No Dock)" },
    { "type": "custom", "key": "🌸 Tema Anime", "format": "Sakura Catppuccin (桜ローファイ // 宵)" },
    { "type": "shell", "key": " Shell" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "cpu", "key": "󰻠 CPU" },
    { "type": "memory", "key": "󰍛 Memoria" },
    "break",
    "colors"
  ]
}
