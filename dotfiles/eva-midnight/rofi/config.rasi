/* KitsuneDE Rofi Wayland Anime Launcher - Midnight Evangelion */
configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "󰣇  drun ❯";
    display-run: "❯_ run";
    display-window: "󰖲  win";
    drun-display-format: "{name}";
}

* {
    bg:      #10081cEB;
    surface: #190e2c;
    primary: #39ff14;
    accent:  #ff9e00;
    fg:      #f0fdf4;
    muted:   #a78bfa;
    font:    "JetBrainsMono Nerd Font 12";
}

window {
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @primary;
    border-radius: 12px;
    padding: 16px;
}

inputbar {
    children: [prompt, entry];
    background-color: @surface;
    border-radius: 10px;
    padding: 10px 14px;
    text-color: @fg;
}

prompt {
    background-color: transparent;
    text-color: @primary;
    padding: 0 10px 0 0;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Buscar aplicación, tema o comando...";
    placeholder-color: @muted;
}

listview {
    lines: 7;
    spacing: 6px;
    margin: 12px 0 0 0;
    background-color: transparent;
}

element {
    padding: 9px 12px;
    border-radius: 9px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @primary;
    text-color: #090812;
    border-radius: 9px;
}

element-icon {
    size: 22px;
    margin: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
