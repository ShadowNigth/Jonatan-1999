/* KitsuneDE Rofi Wayland Anime Launcher - Midnight Evangelion */
* {
    bg:      #10081cE6;
    surface: #190e2c;
    primary: #39ff14;
    accent:  #ff9e00;
    fg:      #f0fdf4;
    muted:   #a78bfa;
    font:    "JetBrainsMono Nerd Font 12";
}

window {
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @primary;
    border-radius: 12px;
    padding: 18px;
}

inputbar {
    children: [prompt, entry];
    background-color: @surface;
    border-radius: 10px;
    padding: 10px 14px;
    text-color: @fg;
}

prompt {
    text-color: @primary;
    padding: 0 10px 0 0;
}

listview {
    lines: 7;
    spacing: 6px;
    margin: 12px 0 0 0;
}

element selected {
    background-color: @primary;
    text-color: #10081c;
    border-radius: 8px;
}
