/* 🦊 Kitsune Go Wayland — Lanzador Rofi (Midnight Evangelion • 第3新東京市 // NERV) */
configuration {
  modi: "drun,run";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  display-drun: "󰣇  Kitsune Go ❯";
  drun-display-format: "{name}";
  font: "JetBrainsMono Nerd Font 11";
}

* {
  bg: #10081cEA;
  bg-alt: #190e2cF2;
  fg: #f0fdf4;
  fg-muted: #a78bfa;
  accent: #39ff14;
  secondary: #ff9e00;
  background-color: transparent;
  text-color: @fg;
}

window {
  width: 620px;
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 12px;
  padding: 18px;
}

inputbar {
  children: [prompt, entry];
  background-color: @bg-alt;
  border-radius: 10px;
  padding: 11px 14px;
  spacing: 10px;
  border: 1px;
  border-color: @secondary;
}

prompt {
  text-color: @accent;
}

listview {
  columns: 2;
  lines: 7;
  spacing: 8px;
  margin: 14px 0 0 0;
}

element {
  padding: 10px 12px;
  border-radius: 9px;
}

element selected.normal {
  background-color: @bg-alt;
  border: 1px;
  border-color: @accent;
  text-color: @accent;
}
